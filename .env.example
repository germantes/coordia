# Servidor Backend COORDIA
PORT=4000
NODE_ENV=development
JWT_SECRET=coordia-dev-secret-local-only-replace-in-prod
FRONTEND_ORIGIN=http://localhost:5173

# Almacenamiento local SQLite
AUTH_DB_PATH=.data/auth.sqlite
REPORT_DB_PATH=.data/reports.sqlite

# Configuración de distribución de alertas (milisegundos)
DISTRIBUTION_INTERVAL_MS=60000
